# =============================================================================
# Variáveis de ambiente — Prototipe (frontend)
#
# Copie este arquivo para `.env` e ajuste os valores:
#   cp .env.example .env
#
# IMPORTANTE: no Vite, apenas variáveis prefixadas com `VITE_` são expostas ao
# código do cliente (AGENTS.md → Environment Variables). As demais são usadas
# somente por scripts/servidor. Nunca comite o arquivo `.env` — ele já está no
# .gitignore.
# =============================================================================

# --- Frontend (expostas ao navegador; sempre prefixadas com VITE_) -----------

# URL base da API do backend (blog, portfólio, contato e autenticação do CMS).
VITE_API_BASE_URL=http://localhost:8000/api

# --- Referência para o backend futuro (README → Environment Variables) -------
# Estas variáveis serão usadas somente no servidor da API — nunca suba valores
# reais para o repositório e mantenha-as fora do bundle do frontend.
#
# DATABASE_URL=postgresql://user:password@localhost:5432/prototipe_db
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# CONTACT_EMAIL=contato@prototipe.dev
# NODE_ENV=development
# API_URL=http://localhost:8000
